{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ghost Monitor",
  "version": "0.4.0",
  "identifier": "com.nexusghost.monitor",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ghost Monitor",
        "width": 1480,
        "height": 920,
        "minWidth": 1200,
        "minHeight": 740,
        "decorations": false,
        "center": true,
        "visible": false,
        "backgroundColor": "#080B0E"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; media-src 'self' blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Turkish",
          "English"
        ],
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": true,
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "publisher": "NexusGhost",
    "category": "Utility",
    "shortDescription": "Windows güvenlik ve tehdit istihbaratı izleyicisi",
    "longDescription": "Ghost Monitor; işlemleri, ağ bağlantılarını, açılış girdilerini ve dosyaları yerel olarak izleyip şüpheli davranışları açıklanabilir sinyallerle raporlar.",
    "copyright": "© 2026 NexusGhost",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQwMEYwODhBMjdBQzMwNzIKUldSeU1Ld25pZ2dQMElEeEUxbGx2NkFnTGdzU2FXWCtCclgrcU9iOE90QTE4ZWJ2ZHUzV2d4MUYK",
      "endpoints": [
        "https://github.com/refonuz-art/GhostMonit-r/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
